#!/bin/sh /etc/rc.common
# OpenWrt procd init script for MochiLedger Sync Server

START=99
STOP=10
USE_PROCD=1

PROG=/usr/bin/mochiledger-sync
DATA_DIR=/etc/mochiledger/data
LISTEN_ADDR=":8787"
# 请修改为你自己的同步密钥（与墨记客户端中的 Bearer Token 保持一致）
SYNC_TOKEN="mochi-secret-token"

start_service() {
	mkdir -p "$DATA_DIR"
	procd_open_instance
	procd_set_param command "$PROG" -addr "$LISTEN_ADDR" -data "$DATA_DIR" -token "$SYNC_TOKEN"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
